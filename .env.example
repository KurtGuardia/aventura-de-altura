# Copia este archivo a .env.local y completa los valores.

# URL pública del sitio (canonical, hreflang, Open Graph). En Netlify, si falta, se usa la variable URL.
NEXT_PUBLIC_SITE_URL=

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
SANITY_REVALIDATE_SECRET=
# Solo para los scripts de seed (scripts/seed*.ts)
SANITY_API_WRITE_TOKEN=

# Traducción automática ES → EN (DeepL). Las claves del plan gratuito terminan en ":fx".
DEEPL_API_KEY=
